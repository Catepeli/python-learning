def compter_mots(phrase):
    compteur = {}
    for mot in phrase.lower().split():
        compteur[mot] = compteur.get(mot, 0) + 1
    return compteur


def main():
    phrase = input("Phrase : ")
    compteur = compter_mots(phrase)

    for mot, nombre in compteur.items():
        print(f"{mot} : {nombre}")


if __name__ == "__main__":
    main()